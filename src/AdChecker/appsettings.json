{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AdChecker": {
    "Analyzer": "Fake",
    "ReviewConfidenceThreshold": 0.7,
    "Guardrails": {
      "MaxTextLength": 2000,
      "MaxImageUrlLength": 2048,
      "AllowedImageHosts": [ "images.example.com" ],
      "ResolveImageHosts": true
    }
  },
  "ContentUnderstanding": {
    "AnalyzerId": "brandSafety",
    "ApiVersion": "2025-11-01",
    "PollInterval": "00:00:01",
    "Timeout": "00:01:00"
  }
}
